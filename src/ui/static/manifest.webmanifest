{
  "name": "Recipe Manager",
  "short_name": "recipes",
  "description": "A self-hosted recipe manager. Import recipes from URLs, search and filter your library, and cook from a clean, installable view.",
  "lang": "en",
  "dir": "ltr",
  "categories": ["food", "productivity", "lifestyle"],
  "display": "standalone",
  "start_url": "/recipes",
  "scope": "/",
  "background_color": "#f1f1ef",
  "theme_color": "#5a7a4f",
  "icons": [
    { "src": "/static/icons/192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/static/icons/512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/static/icons/512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "New recipe",
      "short_name": "New",
      "description": "Create a new recipe",
      "url": "/recipes/new",
      "icons": [{ "src": "/static/icons/192.png", "sizes": "192x192" }]
    },
    {
      "name": "Import from URL",
      "short_name": "Import",
      "description": "Import a recipe from a URL",
      "url": "/import",
      "icons": [{ "src": "/static/icons/192.png", "sizes": "192x192" }]
    },
    {
      "name": "Settings",
      "short_name": "Settings",
      "description": "Open settings",
      "url": "/settings",
      "icons": [{ "src": "/static/icons/192.png", "sizes": "192x192" }]
    }
  ],
  "share_target": {
    "action": "/shared-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}

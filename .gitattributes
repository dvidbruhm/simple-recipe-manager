# Normalize text files to LF in the repo (biome expects LF); prevent CRLF churn on Windows.
* text=auto eol=lf

# Binary assets — never normalize line endings or diff.
*.woff2 binary
*.woff binary
*.ttf binary
*.otf binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.svg binary
